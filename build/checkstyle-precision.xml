<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
  "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
  "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!--
  ADR-0002 enforcement, applied to eir-domain and eir-calc.

  Binary floating point cannot represent 0.01. Accumulated over 360 compounding
  periods the error is real, and the resulting reconciliation break has no single
  diagnosable cause. So the type is banned in the calculation path rather than
  discouraged, and the ban is a build failure rather than a review convention.

  Integer Math.min/max/abs remain available: they are exact, and day-count
  conventions legitimately clamp a day-of-month to 30. Only the double-only
  transcendental and power functions are banned — BigDecimal.pow is the
  replacement for the one that matters here.
-->
<module name="Checker">
  <property name="severity" value="error"/>
  <module name="TreeWalker">

    <!-- Declarations: local variables, fields, parameters, return types, arrays. -->
    <module name="RegexpSinglelineJava">
      <property name="id" value="banPrimitiveFloatingPoint"/>
      <property name="format" value="(?&lt;![\w.$])(double|float)(\s*\[\s*\]\s*|\s+)[\w&lt;]"/>
      <property name="ignoreComments" value="true"/>
      <property name="message"
                value="ADR-0002: primitive 'double'/'float' is banned in the calculation path. Use BigDecimal."/>
    </module>

    <!-- Boxed forms, including generic parameters such as List&lt;Double&gt;. -->
    <module name="RegexpSinglelineJava">
      <property name="id" value="banBoxedFloatingPoint"/>
      <property name="format" value="(?&lt;![\w.$])(Double|Float)(?![\w])"/>
      <property name="ignoreComments" value="true"/>
      <property name="message"
                value="ADR-0002: 'Double'/'Float' is banned in the calculation path. Use BigDecimal."/>
    </module>

    <!-- double-only power and transcendental functions. BigDecimal.pow replaces Math.pow. -->
    <module name="RegexpSinglelineJava">
      <property name="id" value="banDoubleOnlyMath"/>
      <property name="format" value="(?&lt;![\w$])Math\s*\.\s*(pow|sqrt|cbrt|exp|log|log10|log1p|expm1|hypot|ceil|floor|rint)\s*\("/>
      <property name="ignoreComments" value="true"/>
      <property name="message"
                value="ADR-0002: this java.lang.Math function operates on double. Use a BigDecimal equivalent."/>
    </module>

    <!-- doubleValue()/floatValue() silently drop out of the exact domain. -->
    <module name="RegexpSinglelineJava">
      <property name="id" value="banFloatingPointConversion"/>
      <property name="format" value="\.(doubleValue|floatValue)\s*\("/>
      <property name="ignoreComments" value="true"/>
      <property name="message"
                value="ADR-0002: converting to double leaves the exact domain. Keep the value as BigDecimal."/>
    </module>

  </module>
</module>
